{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "arrowParens": "always",
  "sortImports": {},
  "sortPackageJson": false,
  "ignorePatterns": [
    "**/dist/**",
    "**/coverage/**",
    ".adadex/**",
    "tools/oxlint/anti-slop/**",
    "apps/web/src/styles/**",
    "**/tailwind.css",
    "**/tailwind-components.css",
    "package-lock.json",
    "**/*.md",
    "**/*.html"
  ]
}
